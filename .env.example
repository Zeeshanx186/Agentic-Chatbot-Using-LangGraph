# Copy to .env. Leave values empty in git. No spaces around "=".
# Docker's --env-file parser does not trim spaces; python-dotenv does.

# Required to start. The Groq client is built when dexter.backend is imported.
GROQ_API_KEY=

# Required to start. The Tavily client is built at import. DuckDuckGo is the fallback when a search fails.
TAVILY_API_KEY=

# Tool-specific. The tool returns an error string when its key is missing.
OPENWEATHER_API_KEY=
ALPHAVANTAGE_API_KEY=

# Model picker.
# GOOGLE_API_KEY: Gemini models are listed only when this is set.
# OPENROUTER_API_KEY: free tool-calling models from OpenRouter's live catalog.
# OPENAI_API_KEY: set_model(..., provider="openai") reads it. The Chainlit picker does not list OpenAI models.
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Local Ollama. The picker probes OLLAMA_HOST. set_model uses OLLAMA_BASE_URL.
OLLAMA_HOST=
OLLAMA_BASE_URL=

# Optional Groq max_tokens. deploy/compose.oracle.yaml sets 512.
GROQ_MAX_TOKENS=

# Cursor Cloud Agent demo (cursor_coding_agent).
CURSOR_API_KEY=
CURSOR_DEMO_REPO=
CURSOR_AUTO_CREATE_PR=

# Google Workspace OAuth paths. Defaults are credentials.json and token.json.
# Those files are gitignored.
GOOGLE_CREDENTIALS_FILE=
GOOGLE_TOKEN_FILE=

# Chainlit always registers an auth callback.
# Unset DEXTER_STAGING_PASSWORD: header auth, single fixed user, no password prompt.
# Set it: password auth, username dexter, that password. Used by Vercel and the Oracle staging script.
CHAINLIT_AUTH_SECRET=
DEXTER_STAGING_PASSWORD=

# Postgres URL (Neon or any Postgres). Unset: SQLite file agentic_chatbot.db plus local JSON/files.
# Required on Vercel, together with CHAINLIT_AUTH_SECRET and DEXTER_STAGING_PASSWORD.
DATABASE_URL=

# Optional LangSmith tracing.
LANGSMITH_TRACING=
LANGSMITH_ENDPOINT=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# Forwarded by .github/workflows/cicd.yaml. The weather tool does not read it.
WEATHERSTACK_API_KEY=

# Hugging Face cache directory. The Vercel entry sets this under /tmp when VERCEL is present.
HF_HOME=
